# User Management System API (SVC-001) — environment configuration.
# Copy to `.env` and replace every placeholder. Never commit real values.

# Environment flag: development | test | production
NODE_ENV=development

# HTTP port the API listens on (optional, defaults to 3000)
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# Redis connection string (task queue + token blacklist)
REDIS_URL=redis://<host>:6379

# JWT signing secret (HS256). Use a long random value (>= 32 characters).
JWT_SECRET=<replace-with-a-long-random-secret>

# JWT expiry in seconds. Allowed range: 900–3600 (15–60 minutes).
# TODO(stakeholder): exact JWT expiry duration is unresolved.
JWT_EXPIRES_IN=3600

# SMTP credentials for OTP email dispatch
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>

# Log level: error | warn | info | http | verbose | debug | silly (optional, defaults to info)
LOG_LEVEL=info

# --- docker-compose only: credentials for the bundled PostgreSQL container ---
# When using docker-compose, point DATABASE_URL at the `postgres` service, e.g.
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
#   REDIS_URL=redis://redis:6379
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>
