// Prisma schema for the User Management System API (SVC-001).
// The connection string is read exclusively from the DATABASE_URL environment variable.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DELETED
}

// TODO(stakeholder): PII encryption-at-rest approach for `name` and `email` (algorithm, key
// management) is unresolved (US-022). Columns are plain text until it is confirmed.
// TODO(stakeholder): maximum field lengths for `name` and `email` are unresolved; no length
// constraints are applied yet.
model User {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String        @unique
  hashedPassword String        @map("hashed_password")
  status         AccountStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)
  otps           Otp[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otps")
}
