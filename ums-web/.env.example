# Copy to .env (or .env.local) and set values for your environment.
# All runtime configuration for ums-web is read from these variables.

# Base URL of the User Management System API (SVC-001). Required.
VITE_API_BASE_URL=http://localhost:8080

# Request timeout for API calls, in milliseconds. Optional (defaults to 10000).
VITE_API_TIMEOUT_MS=10000

# Scaffold-only feature flag: when "true", protected routes render without a
# session so placeholder screens can be reviewed locally. Never enable in
# deployed environments.
VITE_FEATURE_SCAFFOLD_AUTH_BYPASS=false
